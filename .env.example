# Telegram bot token from @BotFather
BOT_TOKEN=

# Only this Telegram user may talk to the bot (your chat id)
ALLOWED_CHAT_ID=

# opencode serve URL (run `opencode serve` in another terminal)
OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Waterfox profiles root (Firefox-fork cookie store for FB/IG/TikTok)
WATERFOX_PROFILE=C:\Users\Mventor\AppData\Roaming\Waterfox\Profiles

# Safety limits
MAX_UPLOADS_PER_DAY=3
MAX_RESOLUTION=720p
MAX_DURATION_SECONDS=600

# Handles — set via Telegram /set_handle or /set_tiktok (empty = skip watermark, prompts on first run)
TIKTOK_HANDLE=
WATERMARK_HANDLE=
COOKIE_CHECK_HOURS=24

# Default captions — empty (bot fetches from video URL via yt-dlp probe when user skips)
DEFAULT_TITLE=
DEFAULT_SUBTITLE=
