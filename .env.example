# Telegram bot token from @BotFather
BOT_TOKEN=

# opencode serve URL (run `opencode serve` in another terminal)
OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Waterfox profiles root (Firefox-fork cookie store for FB/IG/TikTok)
WATERFOX_PROFILE=C:\Users\Mventor\AppData\Roaming\Waterfox\Profiles

# Safety limits
MAX_UPLOADS_PER_DAY=3
MAX_RESOLUTION=720p
MAX_DURATION_SECONDS=600
